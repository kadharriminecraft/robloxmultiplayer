  "script": "Game.on('join', function (name) { Game.toast(name + ' joined the Gold Rush!'); });\nGame.every(60, function () { Game.addMoney(25); Game.toast('Online bonus: +$25'); });\nGame.on('buy', function (label) {\n  if (label === 'MEGA Dropper') Game.banner('A MEGA DROPPER roars to life!');\n  if (label === 'Diamond Drops') Game.banner('DIAMOND DROPS! The gold mine sparkles.');\n});\n"
}